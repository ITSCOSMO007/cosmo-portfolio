---
const projects = [
  {
    title: "Wong Dhen Cafe",
    industry: "Cafe",
    description: "A warm, minimalist digital presence for a boutique cafe. Focused on capturing the cozy atmosphere and highlighting the signature coffee and food offerings.",
    image: "/images/wongdhen.png",
    link: "https://wongdhencafe.netlify.app/"
  },
  {
    title: "Cafe Di Milano",
    industry: "Premium Restaurant",
    description: "An elegant, high-end restaurant website featuring a dynamic menu showcase and reservation focus, reflecting the authentic Italian dining experience.",
    image: "/images/cafedimilano.png",
    link: "https://cafedimilano.netlify.app/"
  },
  {
    title: "Meraki by NK",
    industry: "Beauty & Business",
    description: "A luxury service showcase for a beauty brand, emphasizing aesthetics, professional services, and high-end branding through clean, modern design.",
    image: "/images/meraki.png",
    link: "https://merakibynk.netlify.app/"
  },
  {
    title: "Body Doctors Gym",
    industry: "Fitness & Strength",
    description: "An energetic, performance-driven gym website designed to showcase modern facilities and drive membership growth through bold visuals and clear CTAs.",
    image: "/images/bodydoctors.png",
    link: "https://bodydoctorsgym.netlify.app/"
  },
  {
    title: "Future Path Navigator",
    industry: "Education & Careers",
    description: "A professional educational platform providing career guidance. Built with a focus on information hierarchy and a clean, trustworthy user experience.",
    image: "/images/futurepath.png",
    link: "https://future-path-navigator--itscosmo007.replit.app/"
  }
];
---

<section id="projects" class="section-container">
  <div class="mb-20">
    <h2 class="text-4xl md:text-6xl font-bold mb-6 text-white">Built for Business.</h2>
    <p class="text-slate-400 text-xl max-w-2xl leading-relaxed">
      I don't just build websites; I build digital storefronts that help local businesses establish authority and attract more customers.
    </p>
  </div>

  <div class="space-y-40">
    {projects.map((project) => (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="browser-mockup group">
          <div class="browser-header">
            <div class="browser-dot bg-[#FF5F56]"></div>
            <div class="browser-dot bg-[#FFBD2E]"></div>
            <div class="browser-dot bg-[#27C93F]"></div>
          </div>
          <div class="aspect-[16/10] overflow-hidden bg-zinc-900">
            <img 
              src={project.image} 
              alt={`${project.title} - ${project.industry} Website Showcase`} 
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        
        <div class="space-y-8">
          <div class="inline-flex px-3 py-1 rounded-full bg-white/5 border border-border text-xs font-bold uppercase tracking-widest text-blue-500">
            {project.industry}
          </div>
          <h3 class="text-4xl md:text-5xl font-bold text-white">{project.title}</h3>
          <p class="text-slate-400 text-lg leading-relaxed max-w-xl">
            {project.description}
          </p>
          <div class="pt-4">
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn-primary group">
              View Live Website
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
