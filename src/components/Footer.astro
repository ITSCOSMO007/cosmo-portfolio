---
const currentYear = new Date().getFullYear();
---

<footer class="py-20 border-t border-border bg-background">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12 mb-20">
      <div>
        <a href="/" class="text-2xl font-bold tracking-tighter text-white mb-6 block">
          BuildWith<span class="text-white/60">Cosmo</span>
        </a>
        <p class="text-slate-500 max-w-sm leading-relaxed">
          Helping cafes, restaurants, gyms and local businesses establish a premium digital presence.
        </p>
      </div>
      
      <div class="grid grid-cols-2 gap-x-20 gap-y-10">
        <div>
          <h4 class="text-white font-bold mb-6">Navigation</h4>
          <ul class="space-y-4">
            <li><a href="#services" class="text-slate-500 hover:text-white transition-colors">Services</a></li>
            <li><a href="#projects" class="text-slate-500 hover:text-white transition-colors">Projects</a></li>
            <li><a href="#about" class="text-slate-500 hover:text-white transition-colors">About</a></li>
            <li><a href="#contact" class="text-slate-500 hover:text-white transition-colors">Contact</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-bold mb-6">Contact</h4>
          <ul class="space-y-4">
            <li><a href="mailto:businessranadaksh@gmail.com" class="text-slate-500 hover:text-white transition-colors">Email</a></li>
            <li><a href="tel:+919220902295" class="text-slate-500 hover:text-white transition-colors">Phone</a></li>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 pt-10 border-t border-border text-xs text-slate-600 font-bold uppercase tracking-widest">
      <div>&copy; {currentYear} BuildWithCosmo. All rights reserved.</div>
      <div class="flex gap-8">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
