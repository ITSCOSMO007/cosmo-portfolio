---
---

<section id="contact" class="section-container">
  <div class="bg-surface border border-border rounded-[2rem] p-8 md:p-20 overflow-hidden relative">
    <!-- Subtle background accent -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-500/5 rounded-full blur-[100px]"></div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 relative z-10">
      <div>
        <h2 class="text-4xl md:text-7xl font-bold mb-8 tracking-tighter">Let's grow your <br /> <span class="text-slate-500">business.</span></h2>
        <p class="text-xl text-slate-400 mb-12 max-w-md leading-relaxed">
          Ready to transform your online presence? I'm currently accepting new projects for cafes, restaurants, gyms, and local businesses.
        </p>
        
        <div class="space-y-10">
          <a href="mailto:businessranadaksh@gmail.com" class="flex items-center gap-6 group w-fit">
            <div class="w-14 h-14 rounded-2xl bg-white/5 border border-border flex items-center justify-center text-slate-400 group-hover:text-blue-500 group-hover:border-blue-500 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <div class="text-xs text-slate-500 uppercase font-black tracking-widest mb-1">Email Me</div>
              <div class="text-white font-bold text-xl">businessranadaksh@gmail.com</div>
            </div>
          </a>
          
          <a href="tel:+919220902295" class="flex items-center gap-6 group w-fit">
            <div class="w-14 h-14 rounded-2xl bg-white/5 border border-border flex items-center justify-center text-slate-400 group-hover:text-blue-500 group-hover:border-blue-500 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <div class="text-xs text-slate-500 uppercase font-black tracking-widest mb-1">Call / WhatsApp</div>
              <div class="text-white font-bold text-xl">+91 9220902295</div>
            </div>
          </a>
        </div>
      </div>

      <div class="bg-background/50 border border-border rounded-3xl p-8 md:p-12 shadow-inner">
        <form class="space-y-8">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-3">
              <label class="text-xs font-black uppercase tracking-widest text-slate-500 ml-1">Full Name</label>
              <input type="text" placeholder="John Doe" class="w-full px-6 py-4 rounded-xl bg-surface border border-border focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-hidden transition-all text-white placeholder:text-slate-600" required />
            </div>
            <div class="space-y-3">
              <label class="text-xs font-black uppercase tracking-widest text-slate-500 ml-1">Email Address</label>
              <input type="email" placeholder="john@example.com" class="w-full px-6 py-4 rounded-xl bg-surface border border-border focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-hidden transition-all text-white placeholder:text-slate-600" required />
            </div>
          </div>
          <div class="space-y-3">
            <label class="text-xs font-black uppercase tracking-widest text-slate-500 ml-1">Industry</label>
            <select class="w-full px-6 py-4 rounded-xl bg-surface border border-border focus:border-blue-500 focus:outline-hidden transition-all text-white appearance-none cursor-pointer">
              <option>Cafe / Restaurant</option>
              <option>Gym / Fitness</option>
              <option>Small Business</option>
              <option>Landing Page</option>
              <option>Website Redesign</option>
            </select>
          </div>
          <div class="space-y-3">
            <label class="text-xs font-black uppercase tracking-widest text-slate-500 ml-1">How can I help?</label>
            <textarea rows="4" placeholder="Tell me about your business goals..." class="w-full px-6 py-4 rounded-xl bg-surface border border-border focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-hidden transition-all text-white placeholder:text-slate-600 resize-none" required></textarea>
          </div>
          <button type="submit" class="btn-primary w-full py-5 text-xl shadow-2xl shadow-blue-500/10 active:scale-95 transition-transform">
            Send Inquiry
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
