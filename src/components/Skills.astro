---
const skills = [
  "Website Design",
  "Responsive Web Design",
  "Landing Page Design",
  "Restaurant Website Development",
  "Cafe Website Development",
  "Gym Website Development",
  "SEO Optimization",
  "UI/UX Design",
  "Business Website Creation",
  "Mobile Optimization",
  "Website Redesign",
  "Client Communication"
];
---

<section class="py-12 border-y border-border bg-surface/10">
  <div class="container mx-auto px-6">
    <div class="flex flex-wrap justify-center gap-4 md:gap-x-12 md:gap-y-6">
      {skills.map(skill => (
        <div class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-slate-500 hover:text-white transition-colors cursor-default">
          <div class="w-1.5 h-1.5 rounded-full bg-blue-500"></div>
          {skill}
        </div>
      ))}
    </div>
  </div>
</section>
